    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dev.veloryn.pl",
        "EXPO_PUBLIC_SENTRY_DSN": "https://8204b547f48c41af95f7e734f7eb8251@errors.veloryn.pl/26",
        "SENTRY_URL": "https://errors.veloryn.pl",
        "SENTRY_ORG": "veloryn",
